{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.postbox": {
			"initial_state": "package",
			"states": {
				"idle": {
					"animations": ["idle"],
					"blend_transition": 0.5,
					"transitions": [
						{"letter": "q.variant == 1"},
						{"package": "q.variant == 2"}
					]
				},
				"letter": {
					"animations": ["letter"],
					"blend_transition": 0.5,
					"transitions": [
						{"idle": "q.variant == 0"},
						{"package": "q.variant == 2"}
					]
				},
				"package": {
					"animations": ["package"],
					"blend_transition": 0.5,
					"transitions": [
						{"letter": "q.variant == 1"}
						//{"idle": "q.variant == 0"}
					]
				}
			}
		}
	}
}