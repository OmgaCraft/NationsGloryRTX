{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.hub_large_gate": {
			"initial_state": "close",
			"states": {
				"close": {
					"animations": ["close"],
					"blend_transition": 1,
					"transitions": [
						{"open": "v.look_at_entity"}
					]
				},
				"open": {
					"animations": ["open"],
					"blend_transition": 1,
					"transitions": [
						{"close": "!v.look_at_entity"}
					]
				}
			}
		}
	}
}