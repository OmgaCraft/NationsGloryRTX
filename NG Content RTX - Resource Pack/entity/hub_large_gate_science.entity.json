{
	"format_version": "1.8.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "nationsglory:hub_large_gate_science",
			"min_engine_version": "1.8.0",
			"materials": {
				"default": "entity_alphablend"
			},
			"textures": {
				"default": "textures/entity/hub_large_gate_science"
			},
			"geometry": {
				"default": "geometry.hub_large_gate"
			},
			"scripts": {
				"pre_animation": [
				"v.rotation_to_camera_0 = -Math.atan2(-q.distance_from_camera * Math.sin(q.rotation_to_camera(0)) - 4, q.distance_from_camera * Math.cos(q.rotation_to_camera(0)));",
				"v.look_at_entity = (q.distance_from_camera <= 10) && (Math.abs(Math.abs(q.rotation_to_camera(1) - q.camera_rotation(1)) - 180) < (200 / q.distance_from_camera)) && (Math.abs(v.rotation_to_camera_0 + q.camera_rotation(0)) < (300 / q.distance_from_camera));"
				]
			},
			"animations": {
				"open": "animation.hub_large_gate.open",
				"close": "animation.hub_large_gate.close"
			},
			"sound_effects": {
                "massive_door_open": "massive_door.open"
            },
			"animation_controllers": [
				{
					"hub_large_gate": "controller.animation.hub_large_gate"  // Ajout du contrôleur d'animation
				}
			],
			"render_controllers": ["controller.render.default"],
			"enable_attachables": true
		}
	}
}